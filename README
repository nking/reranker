=================================

install dependencies:

conda create -q --name reranker python=3.13 -y

conda activate reranker

if on CPU:
    pip install --extra-index-url https://download.pytorch.org/whl/cpu -e ".[cpu]"
else if on Kaggle:
    #use pre-installed CUDA PyTorch:
    python -m venv --system-site-packages /tmp/reranker_venv
    source /tmp/reranker_venv/bin/activate
    pip install -e .
    #and make sure when launching the pipeline to use that path for torchrun or accelerate launch
    /tmp/reranker_venv/bin/torchrun --nproc_per_node=2 src/main/python/movie_lens_reranker/train.py
else if on other GPU:
    pip install --extra-index-url https://download.pytorch.org/whl/cu128 -e ".[gpu]"

